{
  "name": "@erickcosta98/whatsapp-framework",
  "version": "0.1.0",
  "description": "Unified WhatsApp engine built on Baileys with multi-session, anti-ban, and database abstraction",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErickCosta98/whatsapp-framework"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sqlite": {
      "import": "./dist/adapters/sqlite.js",
      "types": "./dist/adapters/sqlite.d.ts"
    },
    "./mysql": {
      "import": "./dist/adapters/mysql.js",
      "types": "./dist/adapters/mysql.d.ts"
    },
    "./postgres": {
      "import": "./dist/adapters/postgres.js",
      "types": "./dist/adapters/postgres.d.ts"
    },
    "./messenger": {
      "import": "./dist/messenger/index.js",
      "types": "./dist/messenger/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "multi-session",
    "messaging"
  ],
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "pino": "^9.0.0"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.0.0",
    "mysql2": "^3.0.0",
    "pg": "^8.0.0",
    "@neoaz07/nkxfca": "1.0.10"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "@neoaz07/nkxfca": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.21.0",
    "better-sqlite3": "^13.0.3",
    "mysql2": "^3.23.3",
    "pg": "^8.23.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
